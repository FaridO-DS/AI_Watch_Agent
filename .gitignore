# ==========================================
# 🕵️‍♂️ AI Tech Watch Agent - Master Gitignore
# ==========================================

# --- Environment Secrets (CRITICAL) ---
.env
*.env
.env.local
.env.development
.env.test
.env.production

# --- Operating System Junk ---
.DS_Store
Thumbs.db
*.log
*.sys

# --- Node / Frontend / Backend Dependencies ---
node_modules/
/frontend/node_modules/
/backend/node_modules/
.npm
.eslintcache

# --- Frontend Build Outputs ---
/frontend/dist/
/backend/dist/
dist/
build/

# --- Python / FastAPI Dependency & Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/
env/

# --- Docker & Dev Tools ---
.docker/
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
